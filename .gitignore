# ---------------------------------------------------------------------------
# Everpure Research Newsletter Builder — ignore rules
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pyright/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node / JS tooling
node_modules/
.eslintcache
*.tsbuildinfo

# OS / editor cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# Backups & scratch files
*.backup.*
*.bak
*.orig
/raw/

# Stray SSH keypair accidentally created in-tree from a botched ssh-keygen
eval "$(ssh-agent -s)"
eval "$(ssh-agent -s)".pub

# ---------------------------------------------------------------------------
# Generated build artifacts
#
# The live site is rebuilt fresh in CI by netlify/build.sh and uploaded as the
# GitHub Pages artifact, so generated outputs do NOT need to be committed.
# ---------------------------------------------------------------------------

# Everything under publish/ is rebuilt by netlify/build.sh (data, api, newsletter,
# issues, history, status.json, .nojekyll, ...). The homepage (publish/index.html)
# is now GENERATED too — it's the trends dashboard (render_trends_dashboard.js,
# the build's last writer of index.html) — so nothing under publish/ is tracked.
/publish/*

# Locally fetched deck artifacts (PDF/PPTX pulled from Google Slides)
/deck_artifacts/
/deck_artifacts_empty/

# clasp local config carries the user's Apps Script id — keep it out of git
# (a .clasp.json.example is tracked instead). Apps Script source under
# appsscript/ IS tracked; clasp credentials never are.
appsscript/.clasp.json
.clasprc.json
