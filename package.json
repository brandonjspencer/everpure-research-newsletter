{
  "name": "everpure-netlify-site",
  "version": "1.0.0",
  "private": true,
  "description": "Netlify deployment bundle for the Everpure research parser and API",
  "scripts": {
    "build": "bash netlify/build.sh",
    "dev": "netlify dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
